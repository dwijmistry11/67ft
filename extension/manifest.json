{
  "manifest_version": 3,
  "name": "67ft",
  "version": "0.1.0",
  "description": "Read an article the way a crawler sees it: Googlebot headers, no cookies, no scripts.",
  "minimum_chrome_version": "116",

  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],

  "background": { "service_worker": "background.js", "type": "module" },

  "action": {
    "default_title": "67ft — reload this page as a crawler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": { "page": "options.html", "open_in_tab": true },

  "commands": {
    "toggle-tab": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Toggle 67ft on the current tab"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
